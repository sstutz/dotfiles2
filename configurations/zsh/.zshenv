export TERMINAL="/usr/bin/alacritty"
export LOCAL_BIN_DIR="$HOME/.local/bin"
export XDG_CONFIG_HOME="$HOME/.config"
export MYVIMRC="$XDG_CONFIG_HOME/vim/myrc.vim"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XKB_DEFAULT_MODEL=pc104
export XKB_DEFAULT_LAYOUT=us,de
export XKB_DEFAULT_OPTIONS=compose:caps,grp:win_space_toggle
export COMPOSER_CACHE_DIR="$XDG_CACHE_HOME/composer"
export DOTFILES="$XDG_CONFIG_HOME/dotfiles2"
export EDITOR="nvim"
export VISUAL="nvim"
export ZDOTDIR="$DOTFILES/configurations/zsh"
export ZPLUGINDIR="$ZDOTDIR/plugins"
export ZDATADIR="$XDG_DATA_HOME/zsh"
export STARSHIP_CONFIG="$DOTFILES/configurations/starship/config.toml"
export LESSEDIT="nvim"
export LESS="--mouse"
export LESSHISTFILE="$XDG_DATA_HOME/lesshst"
export BROWSER="zen-browser"
export ELECTRON_OZONE_PLATFORM_HINT"auto"
export ZVM_SYSTEM_CLIPBOARD_ENABLED=true
