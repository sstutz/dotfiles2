workspace_layout default
focus_follows_mouse yes
focus_wrapping no

##########################################
# configuration for workspace behaviour: #
##########################################
set $ws1 "1"
set $ws2 "2"

################################
#     Assigned Workspace       #
################################

# (W-1)
# ========== Terminals ==========
assign [app_id="(?i).*spotify.*"] $ws1

# (W-2)
# ========== Browser ===========
assign [app_id="(?i).*zen.*"] $ws2

