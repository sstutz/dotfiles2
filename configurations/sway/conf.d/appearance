# title bar
title_align center
font pango:SF Pro Display, Roboto Condensed Bold, Awesome  10
titlebar_padding 4
titlebar_border_thickness 0

# adjusting borders
# for_window [app_id="^.*"] border pixel 0
default_border none
default_floating_border pixel 3
hide_edge_borders smart_no_gaps

# adjust title format
for_window [class=".*"] title_format "*%title"

###############
# Gaps settings
###############
gaps inner 9
gaps outer 3

######################################
# color settings fo windows         #
######################################
set $color1     #282828
set $color2     #d8a657
set $color3     #ea6962

